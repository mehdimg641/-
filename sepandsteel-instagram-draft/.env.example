# Template only; never add real values to source control.
# This file is NOT automatically loaded by the application.
ENABLE_WEBHOOK_RECEIVER=false
ENABLE_OUTBOUND_REPLIES=false
HOST=127.0.0.1
PORT=3000
# Inject three distinct secrets through the deployment secret manager AFTER approval.
META_APP_SECRET=
META_VERIFY_TOKEN=
DEDUPE_HMAC_KEY=
# Approved numeric Instagram professional account ID(s), never a username/Page name.
INSTAGRAM_ACCOUNT_IDS=
DEDUPE_DB_PATH=/data/events.sqlite
DEDUPE_RETENTION_SECONDS=604800
DEDUPE_MAX_RECORDS=100000
MAX_BODY_BYTES=1048576
MAX_EVENTS_PER_REQUEST=1000
# No access-token setting exists: this release has no outbound API adapter.
