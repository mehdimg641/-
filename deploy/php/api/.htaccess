# Only trpc.php and webhook.php are entry points; everything else here is private.
<IfModule mod_authz_core.c>
  <FilesMatch "\.php$">
    Require all denied
  </FilesMatch>
  <FilesMatch "^(trpc|webhook)\.php$">
    Require all granted
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "\.php$">
    Order allow,deny
    Deny from all
  </FilesMatch>
  <FilesMatch "^(trpc|webhook)\.php$">
    Order allow,deny
    Allow from all
  </FilesMatch>
</IfModule>
Options -Indexes
