# Sepand Inbox — production settings for https://sepandsteel.com
# Prefer entering these in cPanel → Setup Node.js App → Environment variables.
# If you use a .env file instead, put it next to app.cjs and make sure it is not publicly downloadable.

NODE_ENV=production
AUTH_MODE=local

# Dashboard login. Use a long, unique password (at least 10 characters).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Random string of 32+ characters; signs the login cookie. Changing it logs everyone out.
JWT_SECRET=

# MySQL database created in cPanel (import database/schema.sql first).
# URL-encode special characters in the password (e.g. @ → %40).
DATABASE_URL=mysql://cpaneluser_sepand:PASSWORD@localhost:3306/cpaneluser_sepand

# Meta app → App settings → Basic → App secret.
META_APP_SECRET=
# Any long random string; enter the same value as "Verify token" in the Meta webhook settings.
META_WEBHOOK_VERIFY_TOKEN=
# Instagram Login token (IGAA…) or Facebook Login page token (EAA…).
META_ACCESS_TOKEN=
# Numeric Instagram professional account id(s), comma separated.
INSTAGRAM_ACCOUNT_IDS=
# Keep false: every reply waits for operator approval.
META_AUTO_REPLY=false
