# Meta / Instagram (see README "Meta setup")
META_APP_SECRET=            # App settings > Basic > App Secret (signs webhook POSTs)
META_WEBHOOK_VERIFY_TOKEN=  # any random string; paste the same value in Meta's webhook form
META_ACCESS_TOKEN=          # long-lived token for the Instagram account
META_INSTAGRAM_ACCOUNT_ID=  # Instagram professional account ID
META_GRAPH_VERSION=v21.0
