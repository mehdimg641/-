# Copy to .env (never commit real values). Secrets should come from the host's secret manager in production.

# MySQL. Without it the inbox runs in memory and loses data on restart.
DATABASE_URL=mysql://user:password@host:3306/sepand_inbox

# Meta app → App settings → Basic → App secret. Used to verify X-Hub-Signature-256; webhook POSTs are rejected without it.
META_APP_SECRET=
# Any long random string; enter the same value as "Verify token" when registering the webhook in Meta.
META_WEBHOOK_VERIFY_TOKEN=
# Instagram Login token (IGAA…) or Facebook Login page token (EAA…). The API host is picked from the prefix.
META_ACCESS_TOKEN=
# Optional: force "instagram" (graph.instagram.com) or "facebook" (graph.facebook.com).
META_API_HOST=
# Optional: Graph API version (defaults: v23.0 for Instagram, v21.0 for Facebook).
META_GRAPH_VERSION=

# Numeric Instagram professional account id(s), comma separated. Events for other accounts are ignored.
INSTAGRAM_ACCOUNT_IDS=

# Keep false: every reply waits for operator approval. true = rules with action "send" go out automatically
# (rules with action "approval" — price, discount, contract — always wait).
META_AUTO_REPLY=false
