# Instagram API with Instagram Login (Meta app "directminion")
# Long-lived Instagram User access token (60 days, refreshable). Never commit the real value.
META_ACCESS_TOKEN=
# Instagram professional account ID of @sepandsteel (from GET /me?fields=user_id,username)
META_INSTAGRAM_ACCOUNT_ID=
# Any random string; must match "Verify token" in the Meta dashboard webhook settings
META_WEBHOOK_VERIFY_TOKEN=
# Instagram app secret, used to verify X-Hub-Signature-256 on incoming webhooks
META_APP_SECRET=
# Keep false until replies are reviewed; true = send replies automatically
META_AUTO_REPLY=false
# Optional
META_GRAPH_VERSION=v23.0
